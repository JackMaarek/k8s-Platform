{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "ml-batch-job values",
  "type": "object",
  "required": ["namespace", "workload", "job", "image"],
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "namespace": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "workload": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["Job"],
          "description": "Workload type. Only Job is currently implemented."
        }
      }
    },
    "job": {
      "type": "object",
      "required": ["runId"],
      "properties": {
        "runId": { "type": "string", "minLength": 1 },
        "ttlSecondsAfterFinished": { "type": "integer", "minimum": 0 }
      }
    },
    "image": {
      "type": "object",
      "properties": {
        "gpu": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "cpu": {
          "type": "object",
          "properties": {
            "repository": { "type": "string" },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        }
      }
    },
    "imagePullSecret": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "secretName": { "type": "string", "minLength": 1 },
        "awsSecretPath": { "type": "string" },
        "secretStoreRef": {
          "type": "object",
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "kind": {
              "type": "string",
              "enum": ["ClusterSecretStore", "SecretStore"]
            }
          }
        }
      },
      "if": {
        "properties": {
          "enabled": { "const": true }
        },
        "required": ["enabled"]
      },
      "then": {
        "required": ["awsSecretPath"],
        "properties": {
          "awsSecretPath": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "irsaRoleArn": { "type": "string" }
      }
    },
    "gpu": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "cpu": {
      "type": "object",
      "properties": {
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "metricsPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "podMonitor": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "scrapeInterval": { "type": "string" }
          }
        },
        "grafanaDashboard": {
          "type": "object",
          "properties": {
            "enabled": { "type": "boolean" },
            "folder": { "type": "string" }
          }
        }
      }
    }
  }
}
