# backend.tf.template
# Remote state for domains/platform — staging environment.
# This file is a TEMPLATE. platform-bot generates backend.tf from it.

terraform {
  backend "s3" {
    bucket         = "k8s-platform-terraform-state-__AWS_ACCOUNT_ID_STAGING__"
    key            = "domains/platform/staging/terraform.tfstate"
    region         = "eu-west-3"
    encrypt        = true
    dynamodb_table = "k8s-platform-terraform-locks"
  }
}
