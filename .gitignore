#IDEA
.idea

# Terraform state — never commit
*.tfstate
*.tfstate.*
*.tfstate.lock.info

# Terraform working directory
.terraform/
.terraform.lock.hcl

# Saved plan files
*.tfplan
tfplan
plan.json

# backend.tf is generated by platform-bot from backend.tf.template on env
# branches and MUST be committed so GitHub Actions CI can load remote state
# during `terraform init`. On `main` the file is not generated by the env
# workflow, so no ignore rule is needed.
# (Intentionally not ignored — do NOT re-add `**/backend.tf` here.)

# Variable files with sensitive values — use terraform.tfvars.example instead
*.tfvars
!*.tfvars.example
!terraform/**/*.tfvars

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraform/
**/.terraform/
.DS_Store
**/.DS_Store
istio-1*

# Ssecrets
*-secrets
*_SECRET*
*/secrets/*
# Custom
*.zip

#Claude
.CLAUDE.md